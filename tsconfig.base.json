{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@novel-theater/config": ["packages/config/src/index.ts"],
      "@novel-theater/types": ["packages/types/src/index.ts"],
      "@novel-theater/core": ["packages/core/src/index.ts"],
      "@novel-theater/storage": ["packages/storage/src/index.ts"],
      "@novel-theater/ai": ["packages/ai/src/index.ts"],
      "@novel-theater/db": ["packages/db/src/index.ts"],
      "@novel-theater/queue": ["packages/queue/src/index.ts"],
      "@novel-theater/auth": ["packages/auth/src/index.ts"],
      "@novel-theater/export": ["packages/export/src/index.ts"]
    }
  }
}
