# ---------------------------------------------------------------------------
# Novel-Theater 環境変数のひな型
# 実値はコミットしないこと。`.env` にコピーして使用する。
# Phase 0 ではどの値も未設定で動作する（LLM/画像はモック/ダミーにフォールバック）。
# ---------------------------------------------------------------------------

# --- LLM（テキスト推論: シーン分割 / プロンプト生成 / 整合判定）---
# 未設定の場合、シーン分割はヒューリスティックにフォールバックする（コスト 0）。
ANTHROPIC_API_KEY=
# 既定の推論モデル。難所=opus、量産=sonnet、雑務=haiku で使い分ける。
ANTHROPIC_MODEL=claude-opus-4-8

# --- 画像生成プロバイダ（アダプタで差し替え）---
# dummy | fal | replicate
IMAGE_PROVIDER=dummy
FAL_KEY=
REPLICATE_API_TOKEN=

# --- コスト / 入力ガード ---
NT_MAX_INPUT_CHARS=20000
NT_COST_LIMIT_USD=1.0

# --- ストレージ（Phase 0 はローカルディスク。将来は S3 互換）---
STORAGE_DIR=.storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- インフラ（docker-compose で起動。Phase 1 以降で使用）---
# DATABASE_URL=postgresql://novel:novel@localhost:5432/novel_theater
# REDIS_URL=redis://localhost:6379
