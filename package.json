{
  "name": "novel-theater",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "小説・文章を読みながらコマ絵・動画に変換する『観る読書』エンジン",
  "scripts": {
    "spike": "tsx scripts/spike.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p apps/worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "worker": "tsx apps/worker/src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
